DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pro100_kartochki
DB_SSLMODE=disable

JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

SERVER_PORT=8080
SERVER_BASE_URL=http://localhost:8080
UPLOAD_PATH=./uploads

# Куда ведёт ссылка из писем для сброса пароля.
# В dev обычно совпадает с SERVER_BASE_URL.
APP_PUBLIC_URL=http://localhost:8080

# SMTP — отправка писем (восстановление пароля).
# Если SMTP_HOST пустой, письма не отправляются (только логируются).
#
# Для Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=starttls
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<App Password>     # нужна 2FA + приложений-пароль
#   SMTP_FROM=you@gmail.com
#
# Для Yandex:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_TLS=ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
